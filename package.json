{
  "name": "spinstream",
  "version": "1.0.4",
  "description": "Streamer Roulette App",
  "main": "main.js",
  "author": "NiskyNow",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/NiskyNow/theme-roulette.git"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "release": "electron-builder --publish always",
    "postbuild": "powershell -Command \"Compress-Archive -Path 'dist/SpinStream_Setup.exe', 'manual.pdf' -DestinationPath 'dist/SpinStream_Install_Set.zip' -Force\""
  },
  "build": {
    "appId": "com.niskynow.spinstream",
    "productName": "SpinStream",
    "compression": "maximum",
    "electronLanguages": [
      "ja",
      "en"
    ],
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "Preload.js",
      "settingsRenderer.js",
      "rouletteRenderer.js",
      "*.html",
      "package.json",
      "roulette_themes/**/*",
      "theme_profiles/**/*",
      "sounds/**/*",
      "!dist",
      "!.git",
      "!.back"
    ],
    "extraResources": [
      {
        "from": "manual.pdf",
        "to": "manual.pdf"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "artifactName": "${productName}_Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    }
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "atomically": "^2.1.0",
    "boolean": "^3.2.0",
    "buffer-crc32": "^0.2.13",
    "cacheable-lookup": "^5.0.4",
    "cacheable-request": "^7.0.4",
    "clone-response": "^1.0.3",
    "conf": "^15.0.2",
    "debounce-fn": "^6.0.0",
    "debug": "^4.4.3",
    "decompress-response": "^6.0.0",
    "defer-to-connect": "^2.0.1",
    "define-data-property": "^1.1.4",
    "define-properties": "^1.2.1",
    "detect-node": "^2.1.0",
    "dot-prop": "^10.1.0",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.6.2",
    "end-of-stream": "^1.4.5",
    "env-paths": "^2.2.1",
    "es-define-property": "^1.0.1",
    "es-errors": "^1.3.0",
    "es6-error": "^4.1.1",
    "escape-string-regexp": "^4.0.0",
    "extract-zip": "^2.0.1",
    "fast-deep-equal": "^3.1.3",
    "fast-uri": "^3.1.0",
    "fd-slicer": "^1.1.0",
    "fs-extra": "^8.1.0",
    "get-stream": "^5.2.0",
    "global-agent": "^3.0.0",
    "globalthis": "^1.0.4",
    "gopd": "^1.2.0",
    "got": "^11.8.6",
    "graceful-fs": "^4.2.11",
    "has-property-descriptors": "^1.0.2",
    "http-cache-semantics": "^4.2.0",
    "http2-wrapper": "^1.0.3",
    "json-buffer": "^3.0.1",
    "json-schema-traverse": "^1.0.0",
    "json-schema-typed": "^8.0.1",
    "json-stringify-safe": "^5.0.1",
    "jsonfile": "^4.0.0",
    "keyv": "^4.5.4",
    "lowercase-keys": "^2.0.0",
    "matcher": "^3.0.0",
    "mimic-function": "^5.0.1",
    "mimic-response": "^1.0.1",
    "ms": "^2.1.3",
    "normalize-url": "^6.1.0",
    "object-keys": "^1.1.1",
    "once": "^1.4.0",
    "p-cancelable": "^2.1.1",
    "pend": "^1.2.0",
    "progress": "^2.0.3",
    "pump": "^3.0.3",
    "quick-lru": "^5.1.1",
    "require-from-string": "^2.0.2",
    "resolve-alpn": "^1.2.1",
    "responselike": "^2.0.1",
    "roarr": "^2.15.4",
    "semver": "^6.3.1",
    "semver-compare": "^1.0.0",
    "serialize-error": "^7.0.1",
    "sprintf-js": "^1.1.3",
    "stubborn-fs": "^2.0.0",
    "stubborn-utils": "^1.0.2",
    "sumchecker": "^3.0.1",
    "sweetalert2": "^11.26.3",
    "tagged-tag": "^1.0.0",
    "type-fest": "^5.2.0",
    "uint8array-extras": "^1.5.0",
    "undici-types": "^6.21.0",
    "universalify": "^0.1.2",
    "when-exit": "^2.1.5",
    "wrappy": "^1.0.2",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "electron": "^39.2.0",
    "electron-builder": "^24.9.1"
  }
}