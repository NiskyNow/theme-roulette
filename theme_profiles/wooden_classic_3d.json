{
  "themeId": "wooden_classic_3d",
  "name": "ウッデンクラシック（背景透過）",
  "backgroundHtml": [
    "<div class=\"outer-wood-frame\"></div>",
    "<div class=\"inner-shadow-ring\"></div>"
  ],
  "foregroundHtml": [
    "<div class=\"pointer\"></div>",
    "",
    "<div class=\"center-hub\">",
    "  <div class=\"hub-content\">",
    "    <div class=\"hub-icon\">▶</div>",
    "    <div class=\"hub-text\">SPIN</div>",
    "  </div>",
    "</div>"
  ],
  "css": [
    "body { overflow: hidden !important; }",
    "",
    ".outer-wood-frame {",
    "  position: absolute;",
    "  top: 260px;",
    "  left: 50%;",
    "  transform: translate(-50%, -50%);",
    "  width: 515px;",
    "  height: 515px;",
    "  border-radius: 50%;",
    "  background: linear-gradient(135deg, #6b4423 0%, #8b5a3c 50%, #6b4423 100%);",
    "  border: 8px solid #5a3a1f;",
    "  box-shadow: inset 0 8px 15px rgba(255, 255, 255, 0.15), inset 0 -8px 20px rgba(0, 0, 0, 0.5), 0 20px 50px rgba(0, 0, 0, 0.6);",
    "  z-index: 10;",
    "  pointer-events: none;",
    "}",
    "",
    ".inner-shadow-ring {",
    "  position: absolute;",
    "  top: 260px;",
    "  left: 50%;",
    "  transform: translate(-50%, -50%);",
    "  width: 495px;",
    "  height: 495px;",
    "  border-radius: 50%;",
    "  box-shadow: inset 0 0 25px rgba(0, 0, 0, 0.6), inset 0 5px 15px rgba(0, 0, 0, 0.4);",
    "  z-index: 11;",
    "  pointer-events: none;",
    "}",
    "",
    ".roulette-wrapper {",
    "  width: 480px !important;",
    "  height: 480px !important;",
    "  position: absolute !important;",
    "  top: 260px;",
    "  left: 50%;",
    "  transform: translate(-50%, -50%);",
    "  margin: 0 !important;",
    "  filter: drop-shadow(0 15px 35px rgba(0, 0, 0, 0.7));",
    "  z-index: 20;",
    "}",
    "",
    "#roulette-svg-target {",
    "  background: #f4e7d7;",
    "  border-radius: 50%;",
    "  box-shadow: inset 0 0 15px rgba(0, 0, 0, 0.2);",
    "  opacity: 1;",
    "}",
    "",
    ".pointer {",
    "  position: absolute;",
    "  top: 5px;",
    "  left: 50%;",
    "  transform: translateX(-50%);",
    "  width: 0;",
    "  height: 0;",
    "  border-left: 20px solid transparent;",
    "  border-right: 20px solid transparent;",
    "  border-top: 45px solid #8b5a3c;",
    "  filter: drop-shadow(0 5px 10px rgba(0, 0, 0, 0.7));",
    "  z-index: 50;",
    "}",
    ".pointer::before {",
    "  content: '';",
    "  position: absolute;",
    "  top: -45px;",
    "  left: -16px;",
    "  width: 0;",
    "  height: 0;",
    "  border-left: 16px solid transparent;",
    "  border-right: 16px solid transparent;",
    "  border-top: 35px solid #a0714d;",
    "}",
    ".pointer::after {",
    "  content: '';",
    "  position: absolute;",
    "  top: -42px;",
    "  left: -12px;",
    "  width: 0;",
    "  height: 0;",
    "  border-left: 12px solid transparent;",
    "  border-right: 12px solid transparent;",
    "  border-top: 28px solid #6b4423;",
    "}",
    "",
    "/* ▼▼▼ 修正: 木の質感を持つ押しやすいボタンへ ▼▼▼ */",
    ".center-hub {",
    "  position: absolute;",
    "  top: 260px;",
    "  left: 50%;",
    "  transform: translate(-50%, -50%);",
    "  width: 100px;",
    "  height: 100px;",
    "  border-radius: 50%;",
    "  background: radial-gradient(circle at 30% 30%, #c9a176, #a0714d 40%, #8b5a3c 70%, #6b4423 100%);",
    "  border: 4px solid #5a3a1f;",
    "  box-shadow: inset -5px -5px 15px rgba(0, 0, 0, 0.5), inset 5px 5px 10px rgba(255, 255, 255, 0.2), 0 10px 25px rgba(0, 0, 0, 0.6);",
    "  z-index: 50;",
    "  display: flex;",
    "  justify-content: center;",
    "  align-items: center;",
    "  /* 重要設定 */",
    "  pointer-events: auto !important;",
    "  cursor: pointer;",
    "  -webkit-app-region: no-drag;",
    "  transition: transform 0.1s, box-shadow 0.1s;",
    "}",
    "",
    ".hub-content {",
    "  display: flex;",
    "  flex-direction: column;",
    "  align-items: center;",
    "  justify-content: center;",
    "  pointer-events: none;",
    "}",
    "",
    ".hub-icon {",
    "  font-size: 24px;",
    "  color: #3e2714;",
    "  text-shadow: 0 1px 1px rgba(255,255,255,0.4);",
    "  margin-bottom: -4px;",
    "}",
    "",
    ".hub-text {",
    "  font-family: 'Arial Black', sans-serif;",
    "  font-size: 16px;",
    "  font-weight: 900;",
    "  color: #3e2714;",
    "  text-shadow: 0 1px 1px rgba(255,255,255,0.4);",
    "  letter-spacing: 1px;",
    "}",
    "",
    "/* ホバー時のアクション */",
    ".center-hub:hover {",
    "  transform: translate(-50%, -50%) scale(1.05);",
    "  box-shadow: inset -5px -5px 15px rgba(0, 0, 0, 0.5), inset 5px 5px 10px rgba(255, 255, 255, 0.3), 0 15px 35px rgba(0, 0, 0, 0.7);",
    "  background: radial-gradient(circle at 30% 30%, #dbb388, #b27e59 40%, #9c6544 70%, #7d5029 100%);",
    "}",
    "",
    ".center-hub:active {",
    "  transform: translate(-50%, -50%) scale(0.95);",
    "  box-shadow: inset 5px 5px 20px rgba(0, 0, 0, 0.6), inset -5px -5px 10px rgba(255, 255, 255, 0.1), 0 5px 10px rgba(0, 0, 0, 0.5);",
    "}",
    "",
    "/* ▼▼▼ 修正: 旧ボタン非表示 ▼▼▼ */",
    "#spinBtn { display: none !important; }",
    "",
    "#result {",
    "  color: #f4e7d7;",
    "  font-size: 30px;",
    "  font-weight: bold;",
    "  text-shadow: 0 3px 8px rgba(0, 0, 0, 0.8), 0 0 2px rgba(139, 90, 60, 0.5);",
    "  letter-spacing: 1px;",
    "  position: absolute;",
    "  top: 640px;",
    "  width: 100%;",
    "  text-align: center;",
    "  pointer-events: none;",
    "  user-select: none;",
    "}",
    "",
    "#legend-area {",
    "  background: rgba(58, 40, 26, 0.92);",
    "  border: 2px solid #8b5a3c;",
    "  border-radius: 12px;",
    "  color: #f4e7d7;",
    "  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6), inset 0 0 20px rgba(107, 68, 35, 0.2);",
    "  backdrop-filter: blur(8px);",
    "  top: 550px !important;",
    "  pointer-events: none;",
    "}"
  ],
  "segmentCss": {
    "path": {
      "stroke": "#D4AF37",
      "stroke-width": 4,
      "fill-type": "solid"
    },
    "text": {
      "font": "bold 22px Arial",
      "fill": "#FFFFFF",
      "filter": "drop-shadow(0px 1px 2px rgba(0, 0, 0, 0.7))",
      "font-size": "22px",
      "font-weight": "bold",
      "font-family": "Arial, sans-serif"
    }
  },
  "colorProfile": {
    "type": "fixed-list",
    "colors": [
      "#8B4513",
      "#A0522D",
      "#CD853F",
      "#DEB887",
      "#D2691E",
      "#8B6914"
    ]
  },
  "svgViewBox": "0 0 480 480"
}